<Window x:Class="SurfaceNotebook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SurfaceNotebook.Controls"
        Title="Surface Notebook · Pen prototype" Width="1180" Height="900"
        MinWidth="640" MinHeight="500" Background="#EEF1F5"
        Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Surface Notebook" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Pen prototype · one page · manual saving" Foreground="#526174" Margin="0,2,0,8" />
                <WrapPanel x:Name="Toolbar">
                    <Button Content="New" Click="New_Click" ToolTip="New page (Ctrl+N)" />
                    <Button Content="Open" Click="Open_Click" ToolTip="Open page (Ctrl+O)" />
                    <Button Content="Save as" Click="Save_Click" ToolTip="Save page (Ctrl+S)" />
                    <RadioButton x:Name="PenButton" Content="Pen" GroupName="Tool" IsChecked="True" VerticalAlignment="Center" Margin="12,8" Checked="Tool_Changed" />
                    <RadioButton x:Name="EraserButton" Content="Eraser" GroupName="Tool" VerticalAlignment="Center" Margin="8" Checked="Tool_Changed" ToolTip="Erase a whole stroke; the pen's inverted tip also erases" />
                    <ComboBox x:Name="ColorPicker" SelectedIndex="0" Width="110" MinHeight="42" Margin="8,4" SelectionChanged="Color_Changed" AutomationProperties.Name="Ink color">
                        <ComboBoxItem Content="Black" Tag="#FF172331" />
                        <ComboBoxItem Content="Blue" Tag="#FF2459CD" />
                        <ComboBoxItem Content="Red" Tag="#FFCE3546" />
                        <ComboBoxItem Content="Green" Tag="#FF16734C" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="Width" VerticalAlignment="Center" />
                        <Slider Width="100" Minimum="0.5" Maximum="12" Value="{Binding Thickness, Mode=TwoWay}" ValueChanged="Thickness_Changed" Margin="8,0" VerticalAlignment="Center" AutomationProperties.Name="Pen thickness" />
                        <TextBlock Text="{Binding Thickness, StringFormat={}{0:F1}}" Width="32" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" ToolTip="Ctrl+Z" />
                    <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" ToolTip="Ctrl+Y" />
                    <Button Content="Clear page" Click="Clear_Click" />
                    <CheckBox Content="Mouse ink" VerticalAlignment="Center" Margin="12,8" Checked="Mouse_Changed" Unchecked="Mouse_Changed" ToolTip="Enable for testing without a pen" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" Padding="16,10">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#34465C" />
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24" CanContentScroll="False">
            <Border BorderBrush="#CAD2DD" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid Width="816" Height="1056">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,816,32" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="White" Geometry="M0,0 H816 V32 H0 Z" />
                                    <GeometryDrawing Geometry="M0,31.5 H816">
                                        <GeometryDrawing.Pen><Pen Brush="#E5EBF3" Thickness="1" /></GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <local:PenCanvas x:Name="InkSurface" Background="Transparent" ClipToBounds="True"
                                     EditingMode="Ink" EditingModeInverted="EraseByStroke" />
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
