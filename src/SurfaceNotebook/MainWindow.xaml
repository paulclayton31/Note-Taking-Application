<Window x:Class="SurfaceNotebook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SurfaceNotebook.Controls"
        Title="Surface Notebook" Width="1280" Height="900" MinWidth="720" MinHeight="520"
        Background="#EEF1F5" Closing="Window_Closing" Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="16,10">
            <StackPanel>
                <DockPanel>
                    <Button Content="Notebooks" DockPanel.Dock="Right" Click="ToggleNavigation_Click" />
                    <StackPanel>
                        <TextBlock Text="Surface Notebook" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageCaption" Text="Opening your notebooks…" Foreground="#526174" Margin="0,2,0,8" />
                    </StackPanel>
                </DockPanel>
                <WrapPanel x:Name="Toolbar">
                    <RadioButton x:Name="PenButton" Content="Pen" GroupName="Tool" IsChecked="True" VerticalAlignment="Center" Margin="8" Checked="Tool_Changed" />
                    <RadioButton x:Name="EraserButton" Content="Eraser" GroupName="Tool" VerticalAlignment="Center" Margin="8" Checked="Tool_Changed" ToolTip="Erase a whole stroke; the pen's inverted tip also erases" />
                    <ComboBox x:Name="ColorPicker" SelectedIndex="0" Width="104" MinHeight="42" Margin="8,4" SelectionChanged="Color_Changed" AutomationProperties.Name="Ink color">
                        <ComboBoxItem Content="Black" Tag="#FF172331" />
                        <ComboBoxItem Content="Blue" Tag="#FF2459CD" />
                        <ComboBoxItem Content="Red" Tag="#FFCE3546" />
                        <ComboBoxItem Content="Green" Tag="#FF16734C" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="Width" VerticalAlignment="Center" />
                        <Slider Width="95" Minimum="0.5" Maximum="12" Value="{Binding Thickness, Mode=TwoWay}" ValueChanged="Thickness_Changed" Margin="8,0" VerticalAlignment="Center" AutomationProperties.Name="Pen thickness" />
                        <TextBlock Text="{Binding Thickness, StringFormat={}{0:F1}}" Width="28" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" ToolTip="Ctrl+Z" />
                    <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" ToolTip="Ctrl+Y" />
                    <Button Content="Clear" Click="Clear_Click" />
                    <Button Content="Import page" Click="Import_Click" />
                    <Button Content="Export page" Click="Export_Click" />
                    <Button Content="Save now" Click="Flush_Click" ToolTip="Flush queued edits (Ctrl+S)" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−" MinWidth="42" Click="ZoomOut_Click" AutomationProperties.Name="Zoom out" />
                    <TextBlock x:Name="ZoomLabel" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+" MinWidth="42" Click="ZoomIn_Click" AutomationProperties.Name="Zoom in" />
                    <Button Content="Fit width" Click="Fit_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#34465C" />
                    <TextBlock Text="Pen writes · one finger moves · two fingers zoom" Foreground="#65758A" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="RecoveryBanner" DockPanel.Dock="Top" Background="#FFF2CD" Padding="16,10" Visibility="Collapsed">
            <DockPanel>
                <Button Content="Dismiss" DockPanel.Dock="Right" Click="DismissRecovery_Click" />
                <TextBlock Text="Your previous session ended unexpectedly. Your last committed notes have been recovered." VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <Border x:Name="NavigationPanel" DockPanel.Dock="Left" Width="228" Background="#F8FAFC" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel x:Name="NavigationControls">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NOTEBOOKS" FontSize="12" Foreground="#526174" FontWeight="SemiBold" Margin="4,4,0,8" />
                    <ComboBox x:Name="NotebookPicker" DisplayMemberPath="Name" MinHeight="42" SelectionChanged="Notebook_Changed" AutomationProperties.Name="Current notebook" />
                    <WrapPanel>
                        <Button Content="New notebook" Click="AddNotebook_Click" />
                        <Button Content="Rename" Click="RenameNotebook_Click" />
                    </WrapPanel>
                    <TextBlock Text="PAGES" FontSize="12" Foreground="#526174" FontWeight="SemiBold" Margin="4,20,0,8" />
                    <WrapPanel>
                        <Button Content="Add page" Click="AddPage_Click" />
                        <Button Content="Rename" Click="RenamePage_Click" />
                    </WrapPanel>
                </StackPanel>
                <ListBox x:Name="PageList" DisplayMemberPath="Name" SelectionChanged="Page_Changed" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Notebook pages">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,14" /><Setter Property="Margin" Value="0,3" /></Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
        <local:PageViewport x:Name="Viewport">
            <Border Width="816" Height="1056" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#CAD2DD" BorderThickness="1">
                <Grid Width="816" Height="1056">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,816,32" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="White" Geometry="M0,0 H816 V32 H0 Z" />
                                    <GeometryDrawing Geometry="M0,31.5 H816">
                                        <GeometryDrawing.Pen><Pen Brush="#E5EBF3" Thickness="1" /></GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <local:PenCanvas x:Name="InkSurface" Background="Transparent" ClipToBounds="True" EditingMode="Ink" EditingModeInverted="EraseByStroke" />
                </Grid>
            </Border>
        </local:PageViewport>
    </DockPanel>
</Window>
