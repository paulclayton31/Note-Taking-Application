<Window x:Class="SurfaceNotebook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SurfaceNotebook.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Surface Notebook" Width="1440" Height="1000" MinWidth="640" MinHeight="560"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        WindowStyle="None" ResizeMode="CanResize" Closing="Window_Closing" Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="UnifiedHeader" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1">
            <Grid Margin="6,0,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="HomeButton" Click="Home_Click" ToolTip="Home · your notebook library" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AccentFill}" CornerRadius="7" Width="28" Height="29">
                                <local:WorkspaceIcon Kind="Notebook" Foreground="White" Width="19" Height="19" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="BrandLabel" Text="surface notebook" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,6,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SidebarButton" Click="ToggleNavigation_Click" ToolTip="Show or hide navigation · Ctrl+B" Padding="10">
                        <local:WorkspaceIcon Kind="Sidebar" Foreground="{DynamicResource Muted}" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
                <Grid x:Name="TabsHost" Grid.Column="1" VerticalAlignment="Center">
                <Border x:Name="TabStrip" Background="Transparent" BorderBrush="{DynamicResource Stroke}" BorderThickness="0">
                    <ListBox x:Name="DocumentTabs" Height="48" Padding="0" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, ElementName=TabsHost}" shell:WindowChrome.IsHitTestVisibleInChrome="True" SelectionChanged="Tab_Changed" PreviewMouseWheel="Tabs_MouseWheel" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="HorizontalOnly">
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Close all tabs" Click="CloseAllTabs_Click"/></ContextMenu></ListBox.ContextMenu>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="10,0,0,0"/><Setter Property="Margin" Value="5,2,0,2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:WorkspaceIcon Kind="Notebook" Foreground="{DynamicResource Muted}" Width="15" Height="15" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" MaxWidth="155" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Click="CloseTab_Click" Tag="{Binding Id}" ToolTip="Close notebook tab" AutomationProperties.Name="{Binding Name, StringFormat=Close {0}}" Height="40" Width="40" MinHeight="40" MinWidth="40" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Path Data="M1,1 L11,11 M1,11 L11,1" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                </Grid>
                <Border Grid.Column="2" Background="Transparent" ToolTip="Drag to move window"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeButton" Click="Theme_Click" ToolTip="Switch light / dark theme" Padding="10"><local:WorkspaceIcon x:Name="ThemeIcon" Kind="Moon" Foreground="{DynamicResource Muted}"/></Button>
                    <Button x:Name="FocusButton" Click="Focus_Click" ToolTip="Focus mode · F11" Padding="10"><local:WorkspaceIcon Kind="Focus" Foreground="{DynamicResource Muted}"/></Button>
                    <Border Width="1" Background="{DynamicResource Stroke}" Margin="5,15"/>
                    <Button Click="Minimize_Click" ToolTip="Minimize" Padding="10"><local:WorkspaceIcon Kind="Minus" Width="14" Height="14" Foreground="{DynamicResource Muted}"/></Button>
                    <Button Click="Maximize_Click" ToolTip="Maximize / restore" Padding="10"><local:WorkspaceIcon Kind="Maximize" Width="13" Height="13" Foreground="{DynamicResource Muted}"/></Button>
                    <Button Click="Close_Click" ToolTip="Close" Padding="10"><local:WorkspaceIcon Kind="Close" Width="15" Height="15" Foreground="{DynamicResource Muted}"/></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="EditorRoot">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="NavigationPanel" Width="248" Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                <Grid x:Name="NavigationControls" Margin="16,18,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,0,14">
                        <Button DockPanel.Dock="Right" Click="AddNotebook_Click" ToolTip="New notebook" Width="44" Padding="10"><local:WorkspaceIcon Kind="Plus" Foreground="{DynamicResource Muted}"/></Button>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="YOUR WORKSPACE" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Text="Notebooks" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel>
                    <ComboBox x:Name="NotebookPicker" Grid.Row="1" SelectionChanged="Notebook_Changed" Margin="0,0,0,12" ToolTip="Switch notebook">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                        <ComboBox.ContextMenu><ContextMenu><MenuItem Header="Rename notebook" Click="RenameNotebook_Click"/><MenuItem Header="Copy notebook" Tag="copy" Click="NotebookAction_Click"/><MenuItem Header="Duplicate notebook" Tag="duplicate" Click="NotebookAction_Click"/><Separator/><MenuItem Header="Delete notebook…" Tag="delete" Click="NotebookAction_Click" Foreground="{DynamicResource Danger}"/></ContextMenu></ComboBox.ContextMenu>
                    </ComboBox>
                    <Grid Grid.Row="2" Margin="0,0,0,18">
                        <TextBox x:Name="SearchBox" Padding="36,10,10,10" TextChanged="Search_Changed" ToolTip="Search page names in this notebook"/>
                        <local:WorkspaceIcon Kind="Search" Width="16" Height="16" Foreground="{DynamicResource Faint}" HorizontalAlignment="Left" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Find a page…" Foreground="{DynamicResource Faint}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <DockPanel Grid.Row="3" Margin="5,0,0,8">
                        <Button x:Name="FavoriteFilterButton" DockPanel.Dock="Right" Click="FavoriteFilter_Click" ToolTip="Filter favorite pages" Width="44" Padding="12"><local:WorkspaceIcon Kind="Star" Width="16" Height="16" Foreground="{DynamicResource Muted}"/></Button>
                        <TextBlock x:Name="PagesLabel" Text="PAGES" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="10"/>
                    </DockPanel>
                    <Border Grid.Row="4" x:Name="RecoveryBanner" Visibility="Collapsed" Background="{DynamicResource Selected}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <DockPanel><Button DockPanel.Dock="Right" Click="DismissRecovery_Click" ToolTip="Dismiss recovery notice" Padding="8"><local:WorkspaceIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource Accent}"/></Button><TextBlock Text="Your saved notes were recovered." TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
                    </Border>
                    <Grid Grid.Row="5">
                        <ListBox x:Name="PageList" SelectionChanged="Page_Changed" ScrollViewer.PanningMode="VerticalOnly" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                                 local:SmoothScroll.Enabled="True" ScrollViewer.CanContentScroll="True"
                                 AllowDrop="True" DragOver="PageList_DragOver" Drop="PageList_Drop" DragLeave="PageList_DragLeave">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="82">
                                        <Grid.ContextMenu>
                                        <ContextMenu Opened="PageMenu_Opened">
                                            <MenuItem Header="Rename page…" Click="RenamePage_Click"/>
                                            <MenuItem Header="Duplicate page" Click="DuplicatePage_Click"/><MenuItem Header="Delete page…" Click="DeletePage_Click" Foreground="{DynamicResource Danger}"/>
                                            <Separator/>
                                            <MenuItem Header="Move earlier" Tag="earlier" Click="MovePage_Click"/>
                                            <MenuItem Header="Move later" Tag="later" Click="MovePage_Click"/>
                                            <Separator/><MenuItem Header="Star / unstar page" Click="Favorite_Click"/>
                                        </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="48" Height="64" Background="#FFFFFEFA" BorderBrush="#D9DCE3" BorderThickness="1" CornerRadius="2"
                                                ToolTip="Drag with mouse or pen to reorder · hold for page actions"
                                                PreviewMouseLeftButtonDown="PageDrag_Start" PreviewMouseMove="PageDrag_Move" PreviewMouseLeftButtonUp="PageDrag_End">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="124"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyPages" Visibility="Collapsed" Text="No pages found.&#10;Try another name or add a page." Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="10,32,10,0"/>
                    </Grid>
                    <StackPanel Grid.Row="6">
                        <Button Click="AddPage_Click" Style="{StaticResource PrimaryButton}" Margin="0,12,0,10">
                            <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Plus" Foreground="White" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="New page" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                        </Button>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="LOCAL LIBRARY" Style="{StaticResource Caption}" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Click="LibraryMenu_Click" ToolTip="Library actions" Padding="10">
                                <local:WorkspaceIcon Kind="More" Foreground="{DynamicResource Muted}" Width="18" Height="18"/>
                                <Button.ContextMenu><ContextMenu><MenuItem Header="Rename notebook…" Click="RenameNotebook_Click"/><MenuItem Header="Copy notebook" Tag="copy" Click="NotebookAction_Click"/><MenuItem Header="Duplicate notebook" Tag="duplicate" Click="NotebookAction_Click"/><Separator/><MenuItem Header="Delete notebook…" Tag="delete" Click="NotebookAction_Click" Foreground="{DynamicResource Danger}"/><MenuItem Header="Import page…" Click="Import_Click"/><MenuItem Header="Export current page…" Click="Export_Click"/><Separator/><MenuItem Header="Save now    Ctrl+S" Click="Flush_Click"/></ContextMenu></Button.ContextMenu>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" x:Name="WorkspaceRoot" Background="{DynamicResource Workspace}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                <Grid x:Name="PageHeader" Grid.Row="0" Height="44" Margin="28,0,18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageCaption" Text="Your notebook" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PaperCaption" Text="US Letter · Portrait" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FavoriteButton" Click="Favorite_Click" ToolTip="Favorite this page" Padding="12"><local:WorkspaceIcon Kind="Star" Foreground="{DynamicResource Muted}" Width="17" Height="17"/></Button>
                        <Button x:Name="PageActionsButton" Click="LibraryMenu_Click" ToolTip="Page actions · duplicate, delete, reorder, rename" Padding="12">
                            <local:WorkspaceIcon Kind="More" Foreground="{DynamicResource Muted}" Width="17" Height="17"/>
                            <Button.ContextMenu>
                                <ContextMenu Opened="PageMenu_Opened">
                                    <MenuItem Header="Rename page…" Click="RenamePage_Click"/>
                                    <MenuItem Header="Duplicate page" Click="DuplicatePage_Click"/><MenuItem Header="Delete page…" Click="DeletePage_Click" Foreground="{DynamicResource Danger}"/>
                                    <Separator/><MenuItem Header="Move earlier" Tag="earlier" Click="MovePage_Click"/>
                                    <MenuItem Header="Move later" Tag="later" Click="MovePage_Click"/>
                                    <Separator/><MenuItem Header="Export page…" Click="Export_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="PaperButton" Click="Paper_Click" ToolTip="Paper size, template, and color" Padding="12">
                            <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Paper" Foreground="{DynamicResource Muted}" Width="17" Height="17"/><TextBlock x:Name="PaperButtonLabel" Text="Paper" Margin="7,0,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" x:Name="MainStage" ClipToBounds="True">
                    <local:PageViewport x:Name="Viewport" Background="{DynamicResource Workspace}">
                        <Grid x:Name="PageHost" Width="816" Height="1056" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border Background="#0D141C30" Margin="-1,3,-1,-4" CornerRadius="2" IsHitTestVisible="False"/>
                            <Border Background="#09141C30" Margin="-3,7,-3,-9" CornerRadius="3" IsHitTestVisible="False"/>
                            <local:PaperSurface x:Name="PaperBackground"/>
                            <local:PenCanvas x:Name="InkSurface" Background="Transparent" ClipToBounds="True" EditingMode="Ink" EditingModeInverted="EraseByStroke" UseCustomCursor="False"/>
                        </Grid>
                    </local:PageViewport>
                    <Canvas>
                    <Border x:Name="ToolbarFrame" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="5"
                            >
                        <DockPanel LastChildFill="True">
                            <Thumb x:Name="ToolbarGrip" DockPanel.Dock="Left" Width="44" MinHeight="44" Focusable="True" Cursor="SizeAll"
                                   AutomationProperties.Name="Move writing toolbar" DragDelta="Toolbar_DragDelta" DragCompleted="Toolbar_DragCompleted"
                                   PreviewKeyDown="ToolbarGrip_KeyDown" ToolTip="Move toolbar · drag with finger, pen, or mouse">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="GripSurface" Background="Transparent" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1">
                                            <local:WorkspaceIcon Kind="Grip" Foreground="{DynamicResource Muted}" Width="18" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GripSurface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="GripSurface" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GripSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <ScrollViewer x:Name="ToolbarScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="Toolbar_MouseWheel">
                            <StackPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="PenButton" PreviewMouseLeftButtonDown="Tool_PointerDown" PreviewKeyDown="Tool_PreviewKeyDown" Click="Tool_Click" GroupName="Tools" Tag="Pen" IsChecked="True" Checked="Tool_Changed" Style="{StaticResource ToolRadio}" ToolTip="Pen · P"><local:WorkspaceIcon Kind="Pen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
                                <RadioButton x:Name="HighlighterButton" PreviewMouseLeftButtonDown="Tool_PointerDown" PreviewKeyDown="Tool_PreviewKeyDown" Click="Tool_Click" GroupName="Tools" Tag="Highlighter" Checked="Tool_Changed" Style="{StaticResource ToolRadio}" ToolTip="Highlighter · H"><local:WorkspaceIcon Kind="Highlight" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
                                <RadioButton x:Name="EraserButton" PreviewMouseLeftButtonDown="Tool_PointerDown" PreviewKeyDown="Tool_PreviewKeyDown" Click="Tool_Click" GroupName="Tools" Tag="Eraser" Checked="Tool_Changed" Style="{StaticResource ToolRadio}" ToolTip="Eraser · E"><local:WorkspaceIcon Kind="Eraser" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
                                <RadioButton x:Name="LassoButton" PreviewMouseLeftButtonDown="Tool_PointerDown" PreviewKeyDown="Tool_PreviewKeyDown" Click="Tool_Click" GroupName="Tools" Tag="Lasso" Checked="Tool_Changed" Style="{StaticResource ToolRadio}" ToolTip="Select ink · L"><local:WorkspaceIcon Kind="Lasso" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
                                <RadioButton x:Name="ShapeButton" PreviewMouseLeftButtonDown="Tool_PointerDown" PreviewKeyDown="Tool_PreviewKeyDown" Click="Tool_Click" GroupName="Tools" Tag="Shape" Checked="Tool_Changed" Style="{StaticResource ToolRadio}" ToolTip="Shapes · S"><local:WorkspaceIcon Kind="Shape" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
                                <RadioButton x:Name="TextButton" PreviewMouseLeftButtonDown="Tool_PointerDown" PreviewKeyDown="Tool_PreviewKeyDown" Click="Tool_Click" GroupName="Tools" Tag="Text" Checked="Tool_Changed" Style="{StaticResource ToolRadio}" ToolTip="Text · T"><local:WorkspaceIcon Kind="Text" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
                                <RadioButton x:Name="HandButton" PreviewMouseLeftButtonDown="Tool_PointerDown" PreviewKeyDown="Tool_PreviewKeyDown" Click="Tool_Click" GroupName="Tools" Tag="Hand" Checked="Tool_Changed" Style="{StaticResource ToolRadio}" ToolTip="Hand / pan · V"><local:WorkspaceIcon Kind="Hand" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
                                <Border Width="1" Height="24" Background="{DynamicResource Stroke}" Margin="7,10"/>
                                <Button x:Name="UndoButton" Click="Undo_Click" Padding="12" ToolTip="Undo · Ctrl+Z"><local:WorkspaceIcon Kind="Undo" Foreground="{DynamicResource Muted}"/></Button>
                                <Button x:Name="RedoButton" Click="Redo_Click" Padding="12" ToolTip="Redo · Ctrl+Y"><local:WorkspaceIcon Kind="Redo" Foreground="{DynamicResource Muted}"/></Button>
                                <Border Width="1" Height="24" Background="{DynamicResource Stroke}" Margin="7,10"/>
                                <Border x:Name="QuickPenStrip" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0" Margin="4,0" Padding="7,0,0,0">
                                    <ItemsControl x:Name="QuickPenList">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Tag="{Binding Id}" Click="ApplyPreset_Click" Width="44" Height="44" Padding="6" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name, StringFormat=Use saved pen {0}}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="BorderBrush" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Grid Width="30" Height="30"><local:WorkspaceIcon Kind="{Binding Icon}" Foreground="{DynamicResource Muted}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top"/><Border Background="{Binding Color}" BorderBrush="{DynamicResource Muted}" BorderThickness=".6" Height="3" Width="17" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"/></Grid>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Button x:Name="ColorButton" Click="ColorMenu_Click" Width="44" Height="44" Padding="10" ToolTip="Choose ink color">
                                    <Ellipse x:Name="CurrentColor" Fill="#FF24324A" Width="22" Height="22" Stroke="{DynamicResource Muted}" StrokeThickness="1"/>
                                </Button>
                                <Button x:Name="PropertiesButton" Click="ToolProperties_Click" Width="44" Height="44" Padding="11" ToolTip="Customize the active tool · saved pens, colors, and settings">
                                    <local:WorkspaceIcon x:Name="MoreToolIcon" Kind="Settings" Foreground="{DynamicResource Accent}"/>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    </Canvas>
                    <Border x:Name="ToolInspector" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="64" Margin="12" Padding="5" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14">
                        <StackPanel>
                            <StackPanel x:Name="SavedPensPanel">
                                <Button x:Name="RailPensButton" Visibility="Collapsed" Click="AllPens_Click" Width="44" Height="44" Padding="10" ToolTip="Your pens"><local:WorkspaceIcon Kind="Pen" Foreground="{DynamicResource Accent}"/></Button>
                                <ScrollViewer x:Name="SavedPenScroll" MaxHeight="132" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="SavedPenList">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Tag="{Binding Id}" Click="ApplyPreset_Click" Width="44" Height="44" Padding="6" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name, StringFormat=Use pen {0}}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="BorderBrush" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Grid Width="30" Height="30"><local:WorkspaceIcon Kind="{Binding Icon}" Foreground="{DynamicResource Muted}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top"/><Border Background="{Binding Color}" BorderBrush="{DynamicResource Muted}" BorderThickness=".6" Height="3" Width="17" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"/></Grid>
                                                <Button.ContextMenu><ContextMenu><MenuItem Header="Rename pen…" Tag="rename" Click="PresetAction_Click"/><MenuItem Header="Remove pen" Tag="remove" Click="PresetAction_Click"/></ContextMenu></Button.ContextMenu>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button x:Name="AddPenButton" Click="AddPen_Click" Width="44" Height="44" Padding="10" ToolTip="Add pen"><local:WorkspaceIcon Kind="Plus" Foreground="{DynamicResource Accent}"/></Button>
                            </StackPanel>
                            <StackPanel x:Name="ColorControls">
                                <Button x:Name="RailColorButton" Click="ColorMenu_Click" Width="44" Height="44" Padding="10" ToolTip="Pen color"><Ellipse x:Name="RailColor" Width="23" Height="23" Stroke="{DynamicResource Muted}" StrokeThickness=".7" Fill="#FF24324A"/></Button>
                            </StackPanel>
                            <StackPanel x:Name="ThicknessControls">
                                <TextBlock x:Name="ThicknessLabel" Visibility="Collapsed" Text="Thickness"/>
                                <Slider x:Name="ThicknessSlider" Style="{StaticResource VerticalToolSlider}" Orientation="Vertical" Width="44" Height="160" AutomationProperties.Name="Tool thickness" Minimum="0.5" Maximum="12" Value="2.5" TickFrequency=".5" IsSnapToTickEnabled="True" ValueChanged="Thickness_Changed"/>
                                <TextBlock x:Name="ThicknessValue" Text="2.5" Height="18" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                            <StackPanel x:Name="PenStyleControls">
                                <RadioButton x:Name="FountainStyleButton" GroupName="PenStyle" Checked="PenStyle_Changed" IsChecked="True" Style="{StaticResource ToolRadio}" ToolTip="Fountain · pressure-sensitive">
                                    <StackPanel><local:WorkspaceIcon Kind="Pen" Width="16" Height="16" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/><TextBlock Text="Fountain" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="BallStyleButton" GroupName="PenStyle" Checked="PenStyle_Changed" Style="{StaticResource ToolRadio}" ToolTip="Ball · monoline">
                                    <StackPanel><Ellipse Width="13" Height="13" Fill="{DynamicResource Ink}" HorizontalAlignment="Center"/><TextBlock Text="Ball" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <Button x:Name="RailOptionsButton" Click="ToolOptions_Click" Width="44" Height="44" Padding="10" ToolTip="More tool options"><local:WorkspaceIcon Kind="More" Foreground="{DynamicResource Muted}"/></Button>
                        </StackPanel>
                    </Border>
                    <Popup x:Name="AllPensPopup" PlacementTarget="{Binding ElementName=RailPensButton}" Placement="Left" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-8">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="14" Width="252">
                            <StackPanel><TextBlock Text="Your pens" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="AllPenList">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Id}" Click="ApplyPreset_Click" Width="68" Padding="4,8" ToolTip="{Binding Description}"><StackPanel><Grid Width="30" Height="28"><local:WorkspaceIcon Kind="{Binding Icon}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><Border Background="{Binding Color}" BorderBrush="{DynamicResource Muted}" BorderThickness=".6" Width="17" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"/></Grid><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="58" FontSize="10" Margin="0,6,0,0" TextAlignment="Center"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem Header="Rename pen…" Tag="rename" Click="PresetAction_Click"/><MenuItem Header="Remove pen" Tag="remove" Click="PresetAction_Click"/></ContextMenu></Button.ContextMenu></Button></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer><Button Click="AddPen_Click" Content="Add pen…" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="ToolOptionsPopup" PlacementTarget="{Binding ElementName=RailOptionsButton}" Placement="Left" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-8">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="16" Width="252">
                            <StackPanel>
                                <TextBlock x:Name="ToolTitle" Text="Pen" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ToolHint" Text="Pressure-sensitive ink" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,10"/>
                                <CheckBox x:Name="ScribbleEraseToggle" Foreground="{DynamicResource Ink}" Content="Scribble to erase" IsChecked="True" Checked="ScribbleErase_Changed" Unchecked="ScribbleErase_Changed" MinHeight="44" VerticalContentAlignment="Center"/>
                                <StackPanel x:Name="EraserControls" Visibility="Collapsed">
                                    <ComboBox x:Name="EraserModePicker" SelectedIndex="0" SelectionChanged="Properties_Changed"><ComboBoxItem Content="Erase whole strokes"/><ComboBoxItem Content="Precision eraser"/></ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="ShapeControls" Visibility="Collapsed">
                                    <ComboBox x:Name="ShapePicker" SelectedIndex="0"><ComboBoxItem Content="Line"/><ComboBoxItem Content="Rectangle"/><ComboBoxItem Content="Ellipse"/><ComboBoxItem Content="Arrow"/></ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="TextControls" Visibility="Collapsed">
                                    <TextBlock Text="TEXT SIZE" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="TextSizePicker" SelectedIndex="1" SelectionChanged="Properties_Changed"><ComboBoxItem Content="16"/><ComboBoxItem Content="20"/><ComboBoxItem Content="28"/><ComboBoxItem Content="36"/></ComboBox>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,18,0,10"/>
                                <Button x:Name="DockToolbarTopButton" Click="DockToolbarTop_Click" HorizontalContentAlignment="Left" Content="Move toolbar to top" FontSize="12"/>
                                <Button x:Name="DockToolbarBottomButton" Click="DockToolbarBottom_Click" HorizontalContentAlignment="Left" Content="Move toolbar to bottom" FontSize="12"/>
                                <Button Click="HideToolbar_Click" HorizontalContentAlignment="Left" Content="Hide writing tools" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="PenEditorPopup" Closed="PenEditor_Closed" PlacementTarget="{Binding ElementName=RailColorButton}" Placement="Left" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-8">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="16" Width="272">
                            <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <StackPanel>
                                <DockPanel><Button DockPanel.Dock="Right" Click="ClosePenEditor_Click" Width="44" Padding="10" ToolTip="Close color picker"><local:WorkspaceIcon Kind="Close" Foreground="{DynamicResource Muted}" Width="16" Height="16"/></Button><TextBlock x:Name="ColorTitle" Text="Pen color" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                <StackPanel x:Name="NewPenOptions" Visibility="Collapsed">
                                    <TextBox x:Name="NewPenName" MaxLength="80" AutomationProperties.Name="New pen name" Margin="0,8,0,8"/>
                                    <UniformGrid Columns="2"><RadioButton x:Name="NewFountainButton" GroupName="NewPenStyle" IsChecked="True" Style="{StaticResource ToolRadio}" Width="110" Content="Fountain" ToolTip="Pressure-sensitive"/><RadioButton x:Name="NewBallButton" GroupName="NewPenStyle" Style="{StaticResource ToolRadio}" Width="110" Content="Ball" ToolTip="Monoline"/></UniformGrid>
                                </StackPanel>
                                <local:ColorWheel x:Name="PenColorWheel" Width="224" Height="224" HorizontalAlignment="Center"/>
                                <DockPanel><TextBlock Text="Brightness" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ColorValue" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel>
                                <Slider x:Name="PenBrightnessSlider" Minimum="0" Maximum="1" Value="1" SmallChange=".01" LargeChange=".1" ValueChanged="Brightness_Changed" AutomationProperties.Name="Color brightness" Height="44"/>
                                <Expander Header="Hex color" Margin="0,4,0,8"><DockPanel><Button DockPanel.Dock="Right" Click="CustomColor_Click" Content="Apply" Margin="8,0,0,0"/><TextBox x:Name="CustomColorBox" MaxLength="9" ToolTip="#RRGGBB or #AARRGGBB" AutomationProperties.Name="Custom ink color hex code"/></DockPanel></Expander>
                                <TextBlock x:Name="ColorValidation" Foreground="{DynamicResource Danger}" FontSize="11" TextWrapping="Wrap"/>
                                <Button x:Name="CommitPenButton" Click="CommitPen_Click" Content="Add pen" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/>
                                <ComboBox x:Name="ColorPicker" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="Color_Changed"><ComboBoxItem Content="Midnight" Tag="#FF24324A"/><ComboBoxItem Content="Indigo" Tag="#FF5C55B3"/><ComboBoxItem Content="Rose" Tag="#FFCE3F53"/><ComboBoxItem Content="Teal" Tag="#FF248779"/><ComboBoxItem Content="Amber" Tag="#FFE7B944"/><ComboBoxItem Content="Sky" Tag="#FF4D8EC9"/><ComboBoxItem Content="White" Tag="#FFFFFFFF"/></ComboBox>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    <Button x:Name="RevealToolbar" Visibility="Collapsed" Click="HideToolbar_Click" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Background="{DynamicResource Surface}" ToolTip="Show writing tools"><local:WorkspaceIcon Kind="Pen" Foreground="{DynamicResource Accent}"/></Button>


                    <Button x:Name="SelectionActionsButton" Visibility="Collapsed" Click="SelectionActions_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="12,8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" ToolTip="Copy, duplicate, or delete the selection">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="SelectionCount" Text="Selection" VerticalAlignment="Center"/><local:WorkspaceIcon Kind="More" Foreground="{DynamicResource Accent}" Width="18" Height="18" Margin="10,0,0,0"/></StackPanel>
                    </Button>
                    <Border x:Name="EditNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" Padding="12,4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Scribble erased" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Click="Undo_Click" Content="Undo" Foreground="{DynamicResource Accent}" ToolTip="Restore the erased content and scribble"/></StackPanel>
                    </Border>
                    <Border x:Name="SaveErrorBanner" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="16" Padding="14"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="10">
                        <DockPanel><Button DockPanel.Dock="Right" Click="Export_Click" Content="Export backup" Margin="12,0,0,0"/><TextBlock Text="Storage is unavailable. Keep the app open while autosave retries. You can export this page for a backup." Foreground="{DynamicResource Danger}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="SaveIndicator" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <Ellipse x:Name="SaveDot" Width="5" Height="5" Fill="#77A18D" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                        <TextBlock x:Name="InputHint" Text="Pen to write · touch to navigate" FontSize="10" Foreground="{DynamicResource Faint}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button x:Name="PreviousPageButton" Click="PreviousPage_Click" ToolTip="Previous page · Alt+Up" Padding="10,5"><local:WorkspaceIcon Kind="Chevron" Foreground="{DynamicResource Muted}" Width="12" Height="12"><local:WorkspaceIcon.RenderTransform><RotateTransform Angle="180" CenterX="6" CenterY="6"/></local:WorkspaceIcon.RenderTransform></local:WorkspaceIcon></Button>
                        <TextBlock x:Name="PageNumber" Text="1 / 1" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0"/>
                        <Button x:Name="NextPageButton" Click="NextPage_Click" ToolTip="Next page · Alt+Down" Padding="10,5"><local:WorkspaceIcon Kind="Chevron" Foreground="{DynamicResource Muted}" Width="12" Height="12"/></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Click="ZoomOut_Click" ToolTip="Zoom out" Padding="7"><local:WorkspaceIcon Kind="Minus" Foreground="{DynamicResource Muted}" Width="14" Height="14"/></Button>
                        <Button x:Name="ZoomButton" Click="ZoomMenu_Click" ToolTip="Zoom · fit width, whole page, or choose a scale" Padding="8,4">
                            <Button.ContextMenu><ContextMenu><MenuItem Header="Fit whole page" Click="Fit_Click"/><MenuItem Header="Fit page width" Click="FitWidth_Click"/><MenuItem Header="Actual size · 100%" Click="ActualSize_Click"/></ContextMenu></Button.ContextMenu>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="ZoomLabel" Text="100%" FontSize="11" Foreground="{DynamicResource Muted}" MinWidth="36" TextAlignment="Center"/><local:WorkspaceIcon Kind="Down" Width="10" Height="10" Foreground="{DynamicResource Muted}" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                        <Button Click="ZoomIn_Click" ToolTip="Zoom in" Padding="7"><local:WorkspaceIcon Kind="Plus" Foreground="{DynamicResource Muted}" Width="14" Height="14"/></Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border x:Name="ContextPanel" Grid.Column="2" Width="312" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0">
                <local:PaperSettingsPanel x:Name="PaperSettingsEditor"/>
            </Border>
        </Grid>
        <local:LibraryHomeView x:Name="HomeView" Grid.Row="1" Visibility="Collapsed"/>
        <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="18" Width="300">
                <StackPanel>
                    <DockPanel><TextBlock Text="Page zoom" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ZoomValueLabel" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></DockPanel>
                    <Slider x:Name="ZoomSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Zoom percentage" ValueChanged="ZoomSlider_Changed" Margin="0,14,0,12" Height="44"/>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Button Content="50%" Tag="50" Click="ZoomPreset_Click"/><Button Content="75%" Tag="75" Click="ZoomPreset_Click"/><Button Content="100%" Tag="100" Click="ZoomPreset_Click"/><Button Content="150%" Tag="150" Click="ZoomPreset_Click"/>
                    </UniformGrid>
                    <Button x:Name="FitWidthButton" Click="FitWidth_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4" Background="{DynamicResource Selected}">
                        <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Fit" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/><TextBlock Text="Fit width" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="FitWholePageButton" Click="Fit_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Page" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><TextBlock Text="Whole page" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock Text="Pinch to zoom · Ctrl + mouse wheel" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,12,0,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
    </Border>
</Window>
