<UserControl x:Class="SurfaceNotebook.Controls.CalculationEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Calculate" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Review your math. Your handwriting stays on the page." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,12"/>
  </StackPanel>
  <TextBlock Grid.Row="1" x:Name="RecognitionStatus" Text="Enter variables and an expression, one per line." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,10"/>
  <TextBox Grid.Row="2" x:Name="SourceBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="12000" MinHeight="80" FontFamily="Cascadia Mono, Consolas" FontSize="17" Padding="12" TextChanged="Source_Changed" AutomationProperties.Name="Reviewed calculation"/>
  <StackPanel Grid.Row="3" Margin="0,8,0,12">
   <WrapPanel>
    <Button x:Name="RecognizeButton" Content="Recognize handwriting" Click="Recognize_Click" Padding="10,5" MinHeight="36" Margin="0,0,8,0"/>
    <Button Content="Use example" Click="Example_Click" Padding="10,5" MinHeight="36" ToolTip="Replace this draft with a worked example"/>
   </WrapPanel>
   <TextBlock Text="Use * for multiplication and ^ for powers. Decimal point · radians · case-sensitive names · no units yet." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
  </StackPanel>
  <Border Grid.Row="4" Background="{DynamicResource Workspace}" CornerRadius="10" Padding="12">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <StackPanel>
     <TextBlock Text="RESULT PREVIEW" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock x:Name="ResultText" FontSize="17" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Calculation result"/>
     <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="13" AutomationProperties.Name="Calculation error"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,16,0,0">
   <Button DockPanel.Dock="Right" x:Name="AcceptButton" Content="Add to page" IsEnabled="False" Click="Accept_Click" Style="{StaticResource PrimaryButton}" Padding="16,10"/>
   <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Padding="16,10" Margin="0,0,8,0"/>
  </DockPanel>
 </Grid>
</UserControl>
