<UserControl x:Class="SurfaceNotebook.Controls.PaperSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SurfaceNotebook.Controls">
    <Grid Margin="20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Click="Close_Click" ToolTip="Close paper settings" Padding="12"><local:WorkspaceIcon Kind="Close" Foreground="{DynamicResource Muted}" Width="16" Height="16"/></Button>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Make it yours" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Paper &amp; page" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,5,0">
                <Border Background="{DynamicResource Workspace}" CornerRadius="10" Padding="24,16" Margin="0,0,0,18" Height="194">
                    <Viewbox Stretch="Uniform"><Border BorderBrush="#D4D8E0" BorderThickness="1"><local:PaperSurface x:Name="Preview" Width="816" Height="1056"/></Border></Viewbox>
                </Border>
                <TextBlock Text="PAPER SIZE" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,8"/>
                <ComboBox x:Name="FormatPicker" AutomationProperties.Name="Paper size" SelectionChanged="Setting_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="US Letter · 8.5 × 11 in"/><ComboBoxItem Content="A4 · 210 × 297 mm"/><ComboBoxItem Content="Legal · 8.5 × 14 in"/><ComboBoxItem Content="Custom dimensions"/>
                </ComboBox>
                <Grid x:Name="CustomDimensions" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Width (inches)" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="CustomWidthBox" Text="8.5" TextChanged="Value_Changed"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Height (inches)" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="CustomHeightBox" Text="11" TextChanged="Value_Changed"/></StackPanel>
                </Grid>
                <ComboBox x:Name="OrientationPicker" SelectedIndex="0" SelectionChanged="Setting_Changed" Margin="0,8,0,18"><ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Landscape"/></ComboBox>
                <TextBlock Text="TEMPLATE" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,8"/>
                <ComboBox x:Name="PatternPicker" SelectionChanged="Setting_Changed" SelectedIndex="1">
                    <ComboBoxItem Content="Blank"/><ComboBoxItem Content="College ruled"/><ComboBoxItem Content="Wide ruled"/><ComboBoxItem Content="Graph"/><ComboBoxItem Content="Dot grid"/><ComboBoxItem Content="Engineering graph"/>
                </ComboBox>
                <StackPanel x:Name="SpacingControls" Margin="0,12,0,0">
                    <DockPanel><TextBlock Text="Grid spacing" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SpacingLabel" HorizontalAlignment="Right" FontSize="12"/></DockPanel>
                    <Slider x:Name="SpacingSlider" AutomationProperties.Name="Grid spacing" Minimum="8" Maximum="96" Value="24" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Spacing_Changed" Height="44" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock Text="PAPER COLOR" Style="{StaticResource Caption}" FontSize="10" Margin="0,20,0,8"/>
                <WrapPanel Margin="-4,0,0,4">
                    <Button Click="BackgroundSwatch_Click" Tag="#FFFFFEFA" ToolTip="Warm white" Padding="6"><Border Width="30" Height="30" Background="#FFFFFEFA" BorderBrush="#CAD0DB" BorderThickness="1" CornerRadius="15"/></Button>
                    <Button Click="BackgroundSwatch_Click" Tag="#FFFFFFFF" ToolTip="Pure white" Padding="6"><Border Width="30" Height="30" Background="White" BorderBrush="#CAD0DB" BorderThickness="1" CornerRadius="15"/></Button>
                    <Button Click="BackgroundSwatch_Click" Tag="#FFF6F0DE" ToolTip="Soft cream" Padding="6"><Border Width="30" Height="30" Background="#F6F0DE" BorderBrush="#CAD0DB" BorderThickness="1" CornerRadius="15"/></Button>
                    <Button Click="BackgroundSwatch_Click" Tag="#FFEAF0EC" ToolTip="Sage" Padding="6"><Border Width="30" Height="30" Background="#EAF0EC" BorderBrush="#CAD0DB" BorderThickness="1" CornerRadius="15"/></Button>
                    <Button Click="BackgroundSwatch_Click" Tag="#FF252B36" ToolTip="Dark paper · choose a light ink color" Padding="6"><Border Width="30" Height="30" Background="#252B36" BorderBrush="#CAD0DB" BorderThickness="1" CornerRadius="15"/></Button>
                </WrapPanel>
                <TextBox x:Name="BackgroundBox" Text="#FFFFFEFA" TextChanged="Value_Changed" MaxLength="9" ToolTip="Paper color · #RRGGBB or #AARRGGBB"/>
                <TextBlock Text="LINE / GRID COLOR" Style="{StaticResource Caption}" FontSize="10" Margin="0,16,0,8"/>
                <TextBox x:Name="LineColorBox" Text="#FFDCE3EC" TextChanged="Value_Changed" MaxLength="9" ToolTip="Line color · #RRGGBB or #AARRGGBB"/>
                <TextBlock Text="Ink stays in place when you change paper. Smaller sizes can crop the view; your ink is preserved." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,16,0,16"/>
                <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ComboBox x:Name="ScopePicker" SelectedIndex="0" Margin="0,0,0,10"><ComboBoxItem Content="Apply to this page"/><ComboBoxItem Content="Apply to all pages in this notebook"/></ComboBox>
            <Button x:Name="ApplyButton" Content="Apply paper" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
