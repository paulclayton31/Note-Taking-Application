<UserControl x:Class="SurfaceNotebook.Controls.LibraryHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SurfaceNotebook.Controls"
             Background="{DynamicResource SurfaceAlt}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="LibraryRail" Width="224" Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="YOUR SPACE" Style="{StaticResource Caption}" FontSize="10" Margin="12,0,0,18"/>
                    <Button x:Name="LibrarySection" Tag="library" Click="Section_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Home" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><TextBlock Text="Library" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="RecentSection" Tag="recent" Click="Section_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Clock" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><TextBlock Text="Recently opened" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="StarredSection" Tag="starred" Click="Section_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Star" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><TextBlock Text="Starred" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <DockPanel Margin="12,26,0,12">
                        <Button DockPanel.Dock="Right" Click="NewFolder_Click" ToolTip="New folder" Padding="10"><local:WorkspaceIcon Kind="Plus" Foreground="{DynamicResource Muted}" Width="16" Height="16"/></Button>
                        <TextBlock Text="FOLDERS" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource Stroke}" Margin="10,12"/>
                    <TextBlock Text="A place for every idea." FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,8,0,8"/>
                    <TextBlock Text="Saved on this device" FontSize="10" Foreground="{DynamicResource Faint}" Margin="12,0,0,6"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="FolderNavigation">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Tag="{Binding Id}" Click="Folder_Click" HorizontalContentAlignment="Left" Margin="{Binding Indent}" ToolTip="{Binding Name}">
                                <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Folder" Foreground="{DynamicResource Muted}" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="32,26,20,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
            <Grid Margin="0,0,12,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <ItemsControl x:Name="Breadcrumbs">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal"><Button Tag="{Binding Id}" Click="Breadcrumb_Click" Content="{Binding Name}" MinHeight="30" MinWidth="0" Padding="0,4,8,4" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="/" Foreground="{DynamicResource Faint}" Margin="0,0,8,0" VerticalAlignment="Center"/></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LibraryTitle" Text="Your notebooks" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,5"/>
                    <TextBlock x:Name="LibrarySubtitle" Text="A little structure. More room to think." FontSize="12" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="NewFolderButton" Click="NewFolder_Click" ToolTip="New folder" BorderBrush="{DynamicResource Stroke}" Margin="0,0,8,0"><local:WorkspaceIcon Kind="FolderPlus" Foreground="{DynamicResource Muted}"/></Button>
                    <Button x:Name="NewNotebookButton" Click="NewNotebook_Click" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal"><local:WorkspaceIcon Kind="Plus" Foreground="White" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="New notebook" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,12,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="LibrarySearch" Padding="38,10,12,10" TextChanged="Search_Changed" AutomationProperties.Name="Search notebooks and folders"/>
                    <local:WorkspaceIcon Kind="Search" Foreground="{DynamicResource Faint}" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="Find a notebook or folder…" Foreground="{DynamicResource Faint}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ComboBox x:Name="SortPicker" Grid.Column="2" SelectedIndex="0" SelectionChanged="Sort_Changed" AutomationProperties.Name="Sort notebooks">
                    <ComboBoxItem Content="Recently opened"/><ComboBoxItem Content="Name · A to Z"/>
                </ComboBox>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="0,0,0,24">
                    <Border x:Name="ResumePanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,26">
                        <Button x:Name="ResumeButton" Click="Resume_Click" Padding="18" HorizontalContentAlignment="Stretch" ToolTip="Continue your last page">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Selected}" CornerRadius="9" Width="44" Height="48"><local:WorkspaceIcon Kind="Pen" Foreground="{DynamicResource Accent}" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CONTINUE WRITING" Style="{StaticResource Caption}" FontSize="9"/><TextBlock x:Name="ResumeTitle" Text="Your notebook" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="ResumeDetail" Text="Pick up where you left off" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
                                <local:WorkspaceIcon Grid.Column="2" Kind="Chevron" Foreground="{DynamicResource Accent}" Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                    </Border>
                    <TextBlock x:Name="FolderHeading" Text="FOLDERS" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="FolderCards" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=local:LibraryHomeView}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,14">
                                <Grid>
                                    <Button Click="Folder_Click" Tag="{Binding Id}" Padding="16" HorizontalContentAlignment="Stretch">
                                        <StackPanel><local:WorkspaceIcon Kind="Folder" Foreground="{DynamicResource Accent}" Width="28" Height="28" HorizontalAlignment="Left" Margin="0,0,0,15"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="190" HorizontalAlignment="Left"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                    </Button>
                                    <Button Click="More_Click" ToolTip="Folder actions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Tag="{Binding Id}" Padding="10">
                                        <local:WorkspaceIcon Kind="More" Foreground="{DynamicResource Muted}" Width="17" Height="17"/>
                                        <Button.ContextMenu><ContextMenu><MenuItem Header="Rename folder…" Tag="rename-folder" Click="Action_Click"/><MenuItem Header="Move folder…" Tag="move-folder" Click="Action_Click"/></ContextMenu></Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,0,16,12"><TextBlock x:Name="NotebookHeading" Text="NOTEBOOKS" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="NotebookCount" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource Faint}" FontSize="10"/></DockPanel>
                    <ItemsControl x:Name="NotebookCards">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=local:LibraryHomeView}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,18">
                                <Grid>
                                    <Button Click="Notebook_Click" Tag="{Binding Id}" HorizontalContentAlignment="Stretch" Padding="0" ToolTip="{Binding Name}">
                                        <StackPanel>
                                            <Border Height="168" Background="{Binding Tint}" CornerRadius="11,11,0,0" ClipToBounds="True">
                                                <Grid Margin="14,14,14,0">
                                                    <Border Background="#12000000" Width="105" Height="135" Margin="4,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                    <Border Background="#FFFFFEFA" BorderBrush="#22000000" BorderThickness="1" Width="104" Height="134" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                        <Grid><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><Border Width="5" Background="{Binding Accent}" HorizontalAlignment="Left"/></Grid>
                                                    </Border>
                                                    <local:WorkspaceIcon Kind="Star" Foreground="{Binding Accent}" Width="16" Height="16" Visibility="{Binding StarVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="16,16,44,16">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="210" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Location}" FontSize="10" Foreground="{DynamicResource Faint}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="210" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="More_Click" ToolTip="Notebook actions" Tag="{Binding Id}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,12" Padding="10">
                                        <local:WorkspaceIcon Kind="More" Foreground="{DynamicResource Muted}" Width="18" Height="18"/>
                                        <Button.ContextMenu><ContextMenu><MenuItem Header="Rename notebook…" Tag="rename-notebook" Click="Action_Click"/><MenuItem Header="Star / unstar notebook" Tag="favorite-notebook" Click="Action_Click"/><Separator/><MenuItem Header="Move to folder…" Tag="move-notebook" Click="Action_Click"/></ContextMenu></Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="EmptyLibrary" Visibility="Collapsed" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="32" Margin="0,0,16,0">
                        <StackPanel HorizontalAlignment="Center"><local:WorkspaceIcon Kind="Notebook" Foreground="{DynamicResource Faint}" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock x:Name="EmptyTitle" Text="Room for your next idea" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Create a notebook here to get started." Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="3" Margin="0,0,12,0"><TextBlock Text="Your notes. On your device." FontSize="10" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        </Grid>
    </Grid>
</UserControl>
