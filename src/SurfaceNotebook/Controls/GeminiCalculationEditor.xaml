<UserControl x:Class="SurfaceNotebook.Controls.GeminiCalculationEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="Calculate with Gemini" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Review the selected image, then choose Solve. Your original notes stay unchanged." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Expander x:Name="SourcePanel" Header="Problem, corrections and Gemini settings" IsExpanded="True" Margin="0,0,0,16">
     <StackPanel Margin="0,12,0,0">
    <Border Background="White" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
     <StackPanel><Image x:Name="SelectionImage" MaxHeight="220" Stretch="Uniform" AutomationProperties.Name="Image sent to Gemini"/><TextBlock x:Name="NoImage" Text="No image selected. Type your problem below." Foreground="#FF334155" TextWrapping="Wrap"/></StackPanel>
    </Border>
    <TextBlock Text="Question or corrections" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBox x:Name="QuestionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="150" VerticalScrollBarVisibility="Auto" MaxLength="12000" Padding="10" TextChanged="Question_Changed" AutomationProperties.Name="Question for Gemini"/>
    <Expander x:Name="SettingsPanel" Header="Gemini API key" Margin="0,12,0,8">
     <StackPanel Margin="0,8,0,0">
      <TextBlock Text="Use a key from your own Google AI Studio project. To stay free, keep billing disabled there. The app cannot check your billing tier." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      <PasswordBox x:Name="KeyBox" MaxLength="512" Padding="10" Margin="0,8,0,8" PasswordChanged="Key_Changed" AutomationProperties.Name="Gemini API key"/>
      <WrapPanel><CheckBox x:Name="RememberKey" Content="Remember on this Windows account" VerticalAlignment="Center" Margin="0,0,12,8"/><Button Content="Forget saved key" Click="Forget_Click" Padding="8,4" Margin="0,0,8,8"/><Button Content="Get a key" Click="GetKey_Click" Padding="8,4" Margin="0,0,0,8"/></WrapPanel>
     </StackPanel>
    </Expander>
    <TextBlock Text="Solve sends only the image above and your question to Google. Free-tier content may be used to improve Google's products. Uses Gemini 3.5 Flash-Lite; no automatic model upgrades or retries." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
    <WrapPanel><Button x:Name="SolveButton" Content="Solve with Gemini" Click="Solve_Click" Style="{StaticResource PrimaryButton}" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Visibility="Collapsed" Padding="12,8" Margin="0,0,0,8"/></WrapPanel>
     </StackPanel>
    </Expander>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" AutomationProperties.Name="Gemini status"/>
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,0,0,8" AutomationProperties.Name="Gemini error"/>
    <Border x:Name="ResultPanel" Visibility="Collapsed" Background="{DynamicResource Workspace}" CornerRadius="8" Padding="16" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="ANSWER" FontSize="11" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/>
      <TextBox x:Name="AnswerText" FontSize="24" FontWeight="SemiBold" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8,0,16" AutomationProperties.Name="AI answer"/>
      <Expander Header="What Gemini read — check the interpretation" Margin="0,0,0,16">
       <TextBox x:Name="ProblemText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8,0,4" AutomationProperties.Name="Interpreted problem"/>
      </Expander>
      <TextBlock Text="WORKED SOLUTION" FontSize="11" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/>
      <TextBox x:Name="ExplanationText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8,0,16" AutomationProperties.Name="Solution overview or clarification"/>
      <ItemsControl x:Name="StepsList">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
          <StackPanel>
           <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,0,0,8"/>
           <TextBox Text="{Binding EquationText, Mode=OneWay}" FontFamily="Cambria Math" FontSize="18" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{DynamicResource Surface}" Padding="10" Visibility="{Binding EquationVisibility}"/>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="CopySolutionButton" Content="Copy solution" Click="CopySolution_Click" HorizontalAlignment="Left" Padding="12,8"/>
     </StackPanel>
    </Border>
    <TextBlock Text="Check the interpreted symbols and answer. AI results can be incorrect." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0"><Button x:Name="AcceptButton" DockPanel.Dock="Right" Content="Add to note" IsEnabled="False" Click="Accept_Click" Style="{StaticResource PrimaryButton}" Padding="14,8"/><Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="14,8" Margin="0,0,8,0"/></DockPanel>
 </Grid>
</UserControl>
